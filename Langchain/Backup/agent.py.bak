def UpdateLLM(modeLLM):
	global llm
	global modeCurrentLLM
	global graph
	# llm = model
	#print(f"UpdateLLM: modeLLM: {modeLLM}")
	# print(f"agent UpdateLLM: modeLLM: {modeLLM} :: modeCurrentLLM: {modeCurrentLLM}")

