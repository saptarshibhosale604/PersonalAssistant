varExit = True

while(varExit):
    print(f"In the while loop: varExit: {varExit}")
    varExit = False
    if '__interrupt__' in result and result['__interrupt__']:
        print("\n print interrupt standard")
        pprint(result['__interrupt__'])
        
        userDecision = input("approve(Y)/reject(n): ")

        print("\n print resume use Decision")
        if userDecision == "n":
            print(f"userDecision: rejected / {userDecision}")
            result = agent.invoke(
                Command( 
                    # resume={"decisions": [{"type": "approve"}]}  # or "edit", "reject"
                    resume={"decisions": [{"type": "reject",
                    # "message": "No, this is wrong because ..., instead use the name XYZ  ...", }]}  # or "edit", "reject"
                    "message": "User rejected the request", }]}  # or "edit", "reject"
                ), 
                config=config # Same thread ID to resume the paused conversatio
            )
            print("print raw result")
            pprint(result)
            print("print pretty result")
            if '__interrupt__' in result and result['__interrupt__']:
                varExit = True
            for msg in result['messages']:
                # Get the class name (e.g., AIMessage, ToolMessage, HumanMessage)
                msg_type = msg.__class__.__name__
                # Get the content
                msg_content = msg.content
                print(f"{msg_type}: {msg_content}")
        else:
            print(f"userDecision: approved / {userDecision}")
            # result = agent.invoke(
            #     Command( 
            #         # resume={"decisions": [{"type": "approve"}, {"type": "approve"} ]}  # or "edit", "reject"
            #         resume={"decisions": [{"type": "approve"}]}  # or "edit", "reject"
            #     ), 
            #     config=config # Same thread ID to resume the paused conversatio
            # )
            for chunk in agent.stream(
                Command( 
                    # resume={"decisions": [{"type": "approve"}, {"type": "approve"} ]}  # or "edit", "reject"
                    resume={"decisions": [{"type": "approve"}]}  # or "edit", "reject"
                ), 
                config=config # Same thread ID to resume the paused conversatio
            ):
                print(chunk.text, end="|", flush=True)
            # for chunk in llm.stream("Why do parrots have colorful feathers?"):
            #     print(chunk.text, end="|", flush=True)

            print("print raw result")
            pprint(result)
            print("print pretty result")
            if '__interrupt__' in result and result['__interrupt__']:
                varExit = True
            for msg in result['messages']:
                # Get the class name (e.g., AIMessage, ToolMessage, HumanMessage)
                msg_type = msg.__class__.__name__
                # Get the content
                msg_content = msg.content
                print(f"{msg_type}: {msg_content}")

