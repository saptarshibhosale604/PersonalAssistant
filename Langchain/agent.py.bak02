async def print_stream_coroutine(graph, inputs, config): # last working state
# def print_stream_coroutine(graph, inputs, config):
# def print_stream(graph, inputs, config):
	global agentOutput

	print(f"Agent: print_stream_coroutine: config: {config}")
	#print("inside print_stream_coroutine")
	print("\n============================================")  # final newline
	print("============================================\n")  # final newline
	async for event in graph.astream_events(inputs, config, version="v1"):
	# for event in graph.astream_events(inputs, config, version="v1"):
		if event["event"] == "on_chat_model_stream":
			chunk = event["data"]["chunk"]
			if chunk.content:
				# print(chunk.content, end="|", flush=True)
				print(chunk.content, end="", flush=True)
				agentOutput += chunk.content
				
	# print()  # final newline
	print("\n============================================")  # final newline
	print("============================================\n")  # final newline
