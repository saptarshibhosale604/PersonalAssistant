from langchain_openai import ChatOpenAI
from langchain.agents import AgentExecutor, create_tool_calling_agent
from langchain_core.tools import tool
from langchain_core.messages import HumanMessage, AIMessage
from langchain import hub
from pprint import pprint

# ============================================================================
# 1. INITIALIZE LLM
# ============================================================================

def InitializeLLM():
    """Initialize the OpenAI LLM."""
    try:
        llm = ChatOpenAI(
            model="gpt-4o-mini-2024-07-18",
            temperature=0,
            verbose=True
        )
        print("✅ LLM initialized successfully!")
        return llm
    except Exception as e:
        print(f"❌ Error initializing LLM: {e}")
        raise


# ============================================================================
# 2. DEFINE TOOLS
# ============================================================================

@tool
def GetWeather(location: str) -> str:
    """Get the current weather for a specific location.
    
    Args:
        location: The city or location name (e.g., 'Pune', 'Mumbai')
    
    Returns:
        Weather information for the location
    """
    # Simulated weather data
    weather_data = {
        "pune": "22°C, Partly Cloudy, Humidity: 65%, Wind: 12 km/h",
        "mumbai": "28°C, Sunny, Humidity: 72%, Wind: 8 km/h",
        "delhi": "18°C, Clear, Humidity: 55%, Wind: 15 km/h",
        "bangalore": "25°C, Rainy, Humidity: 78%, Wind: 10 km/h",
    }
    
    location_lower = location.lower()
    weather = weather_data.get(location_lower, f"Weather data not available for {location}")
    return f"Weather in {location}: {weather}"


@tool
def GetStockPrice(symbol: str) -> str:
    """Get the current stock price for a company symbol.
    
    Args:
        symbol: Stock symbol (e.g., 'AAPL', 'GOOGL', 'TCS')
    
    Returns:
        Current stock price information
    """
    # Simulated stock data
    stock_data = {
        "aapl": "$195.42 (↑ 2.3%)",
        "googl": "$140.85 (↓ 1.2%)",
        "msft": "$445.32 (↑ 0.8%)",
        "tcs": "₹4,250 (↑ 1.5%)",
        "infy": "₹2,150 (↓ 0.3%)",
    }
    
    symbol_lower = symbol.lower()
    price = stock_data.get(symbol_lower, f"Price data not available for {symbol}")
    return f"Stock Price ({symbol.upper()}): {price}"


@tool
def SearchWeb(query: str) -> str:
    """Search the web for information about a topic.
    
    Args:
        query: The search query
    
    Returns:
        Search results summary
    """
    # Simulated search results
    return f"Search Results for '{query}':\n- Result 1: Information about {query}\n- Result 2: Latest news on {query}\n- Result 3: Related topics"


@tool
def Calculator(expression: str) -> str:
    """Perform mathematical calculations.
    
    Args:
        expression: Mathematical expression (e.g., '10 + 5 * 2')
    
    Returns:
        Calculation result
    """
    try:
        result = eval(expression)
        return f"Result of '{expression}': {result}"
    except Exception as e:
        return f"Error calculating '{expression}': {str(e)}"


