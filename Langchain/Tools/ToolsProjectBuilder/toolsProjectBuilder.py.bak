@tool
def toolAssembleProject() -> dict:
    """
    Assemble the project
    """
    # Generates the application's main() function and assembles every
    # generated Python file into a single runnable project.py file.

    PROJECT_MAIN_FILE = f"{PROJECT_SCRIPTS}/main.py"
    PROJECT_OUTPUT_FILE = f"{PROJECT_SCRIPTS}/project.py"

    # ------------------------------------------------------------
    # Load architecture
    # ------------------------------------------------------------
    try:
        with open(PROJECT_ARCHITECTURES_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

        result = data.get("result", {})

        functions = result.get("functions", [])
        dependencies = result.get("dependencies", {})

        if not functions:
            raise ValueError("No functions found.")

    except FileNotFoundError:
        return f"Could not find '{PROJECT_ARCHITECTURES_FILE}'."

    except json.JSONDecodeError as e:
        return f"Invalid JSON: {e}"

    except Exception as e:
        return str(e)

    # ------------------------------------------------------------
    # Load project goal
    # ------------------------------------------------------------
    try:
        with open(PROJECT_GOAL_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

        project_goal = (
            data.get("result", {})
            .get("projectGoal", "")
        )

    except Exception:
        project_goal = ""

    # ------------------------------------------------------------
    # Read every generated function
    # ------------------------------------------------------------
    functionCode = ""

    for function in functions:

        filename = f"{PROJECT_SCRIPTS}/{function['name']}.py"

        try:
            with open(filename, "r", encoding="utf-8") as f:
                functionCode += f.read().rstrip()
                functionCode += "\n\n"

        except FileNotFoundError:
            print(f"Missing script: {filename}")

    # ------------------------------------------------------------
    # Generate main.py
    # ------------------------------------------------------------
    promptText = f"""
You are an expert Python software engineer.

Generate ONLY the application's main() function.

The functions already exist.

DO NOT regenerate any existing functions.

Project Goal:
{project_goal}

Function Specifications:
{json.dumps(functions, indent=2)}

Dependency Graph:
{json.dumps(dependencies, indent=2)}

Requirements:

- Generate ONLY:
    def main():
- Use the existing functions.
- Use the dependency graph.
- Call the functions in the proper order.
- Handle return values.
- Do not redefine any function.
- End with:

if __name__ == "__main__":
    main()

Output Rules:

- Return ONLY Python.
- No markdown.
- No explanations.
- No comments outside the code.
- The first character must be 'd'.
"""

    result = RunPyToolPipeline(promptText, PROJECT_MAIN_FILE)

    if "error" in result:
        return "Failed to generate main.py"

    print(f"Generated {PROJECT_MAIN_FILE}")

    # ------------------------------------------------------------
    # Assemble project.py
    # ------------------------------------------------------------
    projectCode = ""

    # Add every generated function
    for function in functions:

        filename = f"{PROJECT_SCRIPTS}/{function['name']}.py"

        try:
            with open(filename, "r", encoding="utf-8") as f:
                projectCode += f.read().rstrip()
                projectCode += "\n\n"

        except FileNotFoundError:
            print(f"Skipping missing file: {filename}")

    # Add generated main.py
    try:
        with open(PROJECT_MAIN_FILE, "r", encoding="utf-8") as f:
            projectCode += f.read()

    except FileNotFoundError:
        return "main.py was not generated."

    # Save final project.py
    try:
        SavePythonToFile(projectCode, PROJECT_OUTPUT_FILE)
        print(f"Saving the file: {PROJECT_OUTPUT_FILE}")

    except Exception as e:
        return f"Failed assembling project.py: {e}"

    return f"""
Project assembled successfully.

Generated:
- {PROJECT_MAIN_FILE}

Assembled:
- {PROJECT_OUTPUT_FILE}
"""

# ------------------------------------------------------------------ #
# Tool registry (mirrors toolsPii.py's ToolsList pattern)
# ------------------------------------------------------------------ #
toolsBasic = [toolCreateProjectIdea, toolSummarizeProjectGoal, toolProposeArchitectures, toolCreateFunctionScript, toolAssembleProject]
tools = toolsBasic


def ToolsList():
    global tools
    return tools