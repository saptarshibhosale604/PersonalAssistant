@tool
def toolCreateProjectIdea(userInput: str) -> dict:
    '''If input asks to "create a project idea" or "come up with a project" from a rough user input.'''
    promptText = (
        "You are a software project consultant. Based on the user's input below, "
        "write a single descriptive software project idea (3-6 sentences covering "
        "the problem it solves, target users, and core features).\n\n"
        f"User input: '{userInput}'\n\n"
        "Respond ONLY with valid JSON in exactly this shape, no extra text:\n"
        '{"projectIdea": "<the descriptive project idea>"}'
    )
    # return RunJsonToolPipeline(promptText, PROJECT_IDEA_FILE)
    if RunJsonToolPipeline(promptText, PROJECT_IDEA_FILE):
        # return f"Project Idea created here: {PROJECT_IDEA_FILE}"
        return f"""
Project idea successfully generated.

IMPORTANT:
The requested project idea has already been completely generated and saved.
Do NOT regenerate, summarize, expand, or rewrite the project idea.
Simply tell the user where it was saved.
Saved to:
{PROJECT_IDEA_FILE}
        """
    else:
        return f"Failed to create the project idea"


@tool
def toolSummarizeProjectGoal(userInput: str) -> dict:
    '''If input asks to "summarize the project idea" into a short project goal.'''
    raw_project_idea = ""

    try:
        with open(PROJECT_IDEA_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
        
        # Extract the project idea from "result.projectIdea"
        raw_project_idea = data.get("result", {}).get("projectIdea")
        
        if not raw_project_idea:
            raise ValueError("Could not find 'projectIdea' in the JSON file.")

    except FileNotFoundError:
        # Fallback or error handling for missing files during development/testing
        print(f"File {PROJECT_IDEA_FILE} not found. Using default fallback idea.")
        raw_project_idea = "There is nothing in my mind right now"
        
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON file: {e}")
        raw_project_idea = "There is nothing in my mind right now"

    promptText = (
        "You are a software project consultant. Summarize the descriptive project "
        "idea below into a single short, punchy project goal (max 2 sentences).\n\n"
        f"Project idea: '{raw_project_idea}'\n\n"
        "Respond ONLY with valid JSON in exactly this shape, no extra text:\n"
        '{"projectGoal": "<the short project goal>"}'
    )
    # return RunJsonToolPipeline(promptText, PROJECT_GOAL_FILE)
    if RunJsonToolPipeline(promptText, PROJECT_GOAL_FILE):
        return f"""
Project idea successfully generated.

IMPORTANT:
The requested project goal has already been completely generated and saved.
Do NOT regenerate, summarize, expand, or rewrite the project idea.
Simply tell the user where it was saved.
Saved to:
{PROJECT_GOAL_FILE}
        """
    else:
        return f"Failed to create the project idea"


@tool
def toolProposeArchitectures(userInput: str) -> dict:
    '''If input asks to "propose architectures" or "suggest software architecture options" for a project.'''
    
    # 1. Load Project Idea from file (referencing the working function logic)
    raw_project_idea = ""
    try:
        with open(PROJECT_IDEA_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
        
        raw_project_idea = data.get("result", {}).get("projectIdea")
        
        if not raw_project_idea:
            raise ValueError("Could not find 'projectIdea' in the JSON file.")

    except FileNotFoundError:
        print(f"File {PROJECT_IDEA_FILE} not found. Using default fallback idea.")
        raw_project_idea = "There is nothing in my mind right now"
        
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON file: {e}")
        raw_project_idea = "There is nothing in my mind right now"

    # 2. Load Project Goal from file (referencing the working function logic)
    project_goal_text = ""
    try:
        with open(PROJECT_GOAL_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
        
        raw_project_goal = data.get("result", {}).get("projectGoal")
        
        if not raw_project_goal:
            raise ValueError("Could not find 'projectGoal' in the JSON file.")

    except FileNotFoundError:
        print(f"File {PROJECT_GOAL_FILE} not found. Using default fallback goal.")
        project_goal_text = "There is nothing specific defined yet."
        
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON file: {e}")
        project_goal_text = "There is nothing specific defined yet."

    # 3. Construct PromptText using the original raw function's structure but with loaded data
    promptText = f"""
# Role
You are a Python API Generator. Your task is to analyze the provided Project idea and Project goal and output ONLY a valid JSON object representing the function signatures, parameters, outputs, and dependencies of the system. Do not include any markdown text outside the code block or conversational filler.

# Input Data
"Project idea: '{raw_project_idea}'\n\n"
"Project goal: '{project_goal_text}'\n\n"

# Constraints & Rules
1. **Output Format ONLY**: Return exactly one JSON object wrapped in a ```json ... ``` markdown code block. No other text before or after the code block.
2. **Structure**: The JSON must contain two keys: `functions` (a list of objects) and `dependencies` (an array mapping function IDs to their required dependencies).
3. **Function Object Structure**: Each item in `functions` must have exactly these fields:
   - `name`: String (camelCase, e.g., "process_data")
   - `description`: Short string explaining what it does.
   - `input_params`: List of objects with keys `{{param_name}}: {{type_hint}}` (e.g., [{{"id": "user_id", "type": "int"}}])
   - `output_param`: Object with key `{{return_type}}` and value description or type hint.
4. **Dependencies**: Map each function by its ID to the list of other function IDs it calls directly. If a function is independent, use an empty array [].

"""

    # promptText = (
    #     "You are a senior software architect. Given the project description below, "
    #     "propose between 2 and 4 candidate software architectures.\n\n"
    #     f"Project idea: '{raw_project_idea}'\n\n"
    #     f"Project goal: '{project_goal_text}'\n\n"
    #     "Respond ONLY with valid JSON in exactly this shape, no extra text:\n"
