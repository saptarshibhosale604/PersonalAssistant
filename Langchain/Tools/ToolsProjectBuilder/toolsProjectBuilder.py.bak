    #     '"disadvantages": ["<disadvantage 1>", "<disadvantage 2>"]}'
    #     "]}"
    # )

    # 4. Execute Pipeline and Handle Return (referencing the working function logic)
    if RunJsonToolPipeline(promptText, PROJECT_ARCHITECTURES_FILE):
        return f"""
Architectures successfully generated.

IMPORTANT:
The requested software architecture proposals have already been completely generated and saved.
Do NOT regenerate or rewrite them manually.
Simply tell the user where they were saved.
Saved to:
{PROJECT_ARCHITECTURES_FILE}
        """
    else:
        return f"Failed to create the architectural proposal."

