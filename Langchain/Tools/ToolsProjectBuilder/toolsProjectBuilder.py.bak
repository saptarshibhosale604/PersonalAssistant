@tool
def toolCreateFunctionScript(userInput: str) -> dict:
    """
    Generate Python function implementations for every function
    defined in project_arch.json -> result.functions.
    """

    try:
        with open(PROJECT_ARCHITECTURES_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

        functions = data.get("result", {}).get("functions")

        if not functions:
            raise ValueError("Could not find 'functions' in the JSON file.")

    except FileNotFoundError:
        return "project_arch.json not found."

    except json.JSONDecodeError as e:
        return f"Invalid JSON: {e}"

    except Exception as e:
        return str(e)

    
    # 2. Load Project Goal from file (referencing the working function logic)
    project_goal_text = ""
    try:
        with open(PROJECT_GOAL_FILE, 'r', encoding='utf-8') as f:
            data = json.load(f)
        
        raw_project_goal = data.get("result", {}).get("projectGoal")
        
        if not raw_project_goal:
            raise ValueError("Could not find 'projectGoal' in the JSON file.")

    except FileNotFoundError:
        print(f"File {PROJECT_GOAL_FILE} not found. Using default fallback goal.")
        project_goal_text = "There is nothing specific defined yet."
        
    except json.JSONDecodeError as e:
        print(f"Failed to parse JSON file: {e}")
        project_goal_text = "There is nothing specific defined yet."


    functionCounter = 0
    generated = []

    for function in functions:
        functionCounter += 1
        promptText = f"""
You are an expert Python software engineer.

Generate ONLY ONE Python function.

Project Goal:
{project_goal_text}

Function Specification:
{json.dumps(function, indent=2)}

Requirements:
- Implement exactly this function.
- Include type hints.
- Include a docstring.
- Do NOT call the function.
- Do NOT generate any other helper functions.
- Return ONLY valid python script.

Output Rules:
- Return ONLY the Python function.
- Do NOT wrap the code in markdown.
- Do NOT include ```python.
- Do NOT include explanations.
- Do NOT include comments outside the function.
- Do NOT return JSON.
- The first character of your response must be `d` from the word `def`.
"""

        # outputFile = os.path.join(
        #     PROJECT_SCRIPTS,
        #     f"{function['name']}.json"
        # )

        outputFile = f"{PROJECT_SCRIPTS}/{function['name']}.py"

        # if RunJsonToolPipeline(promptText, outputFile):
        if RunPyToolPipeline(promptText, outputFile):
            generated.append(function["name"])
            print(f"Function {functionCounter} generation done")
            print(f"Function name: '{function["name"]}'")
            print(f"Function file: '{outputFile}'\n")

    return f"""
Generated {len(generated)} functions.

Saved into:
{PROJECT_SCRIPTS}
"""

